   "source": [
    "### \ud83d\uddc3\ufe0f 5. Massive Synthetic Data Generation (vLLM for Speed)\n",
    "Generates millions of structured SVOMPTR English-Myanmar pairs rapidly. Resumes automatically if interrupted."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [    "source": [
    "%%writefile generate_data.py\n",
    "import os\n",
    "import json\n",
    "import time\n",
    "import torch\n",
    "\n",
    "DRY_RUN = os.getenv(\"SVOMPTR_DRY_RUN\", \"false\").lower() == \"true\"\n",
    "TARGET_COUNT = 100 if DRY_RUN else 5_000_000\n",
    "\n",
    "teacher_model_id = \"Qwen/Qwen2.5-7B-Instruct\"\n",
    "\n",
    "try:\n",
    "    brain_dir = '/content/drive/MyDrive/svomptr_brain'\n",
    "    dataset_file = os.path.join(brain_dir, 'datasets', f'synthetic_{TARGET_COUNT}.jsonl')\n",
    "    \n",
    "    if not torch.cuda.is_available():\n",
    "        # Use a much lighter model for CPU testing to avoid OOM/Hanging\n",
    "        teacher_model_id = \"Qwen/Qwen2.5-0.5B-Instruct\"\n",
    "        print(f\"CPU Mode: Using lighter {teacher_model_id} for error checking\")\n",
    "        from transformers import pipeline\n",
    "        pipe = pipeline('text-generation', model=teacher_model_id, device_map='cpu')\n",
    "        USE_VLLM = False\n",
    "    else:\n",
    "        print(f\"GPU Mode: Using {teacher_model_id} via vLLM\")\n",
    "        from vllm import LLM, SamplingParams\n",
    "        llm = LLM(model=teacher_model_id, dtype=\"bfloat16\", max_model_len=4096, enable_prefix_caching=True)\n",
    "        sampling_params = SamplingParams(temperature=0.7, top_p=0.9, max_tokens=300)\n",
    "        USE_VLLM = True\n",
    "except Exception as e:\n",
    "    print(f\"vLLM initialization failed ({e}). Falling back to CPU Mode.\")\n",
    "    from transformers import pipeline\n",
    "    pipe = pipeline('text-generation', model=teacher_model_id, device_map='cpu')\n",
    "    USE_VLLM = False\n",
    "\n",
    "generated_count = 0\n",
    "if os.path.exists(dataset_file):\n",
    "    with open(dataset_file, 'r', encoding='utf-8') as f:\n",
    "        generated_count = sum(1 for _ in f)\n",
    "print(f\"Resuming generation from {generated_count}/{TARGET_COUNT} items...\")\n",
    "\n",
    "BATCH_SIZE = (5000 if USE_VLLM else 5) if not DRY_RUN else 2\n",
    "\n",
    "base_prompt = \"Generate one complex English sentence and its precise Myanmar translation with detailed SVOMPTR analysis in JSON format.\"\n",
    "\n",
    "while generated_count < TARGET_COUNT:\n",
    "    t0 = time.time()\n",
    "    current_batch = BATCH_SIZE if USE_VLLM else min(BATCH_SIZE, 5)\n",
    "    prompts = [base_prompt for _ in range(current_batch)]\n",
    "    \n",
    "    if USE_VLLM:\n",
    "        outputs_raw = llm.generate(prompts, sampling_params, use_tqdm=False)\n",
    "        outputs = [out.outputs[0].text.strip() for out in outputs_raw]\n",
    "    else:\n",
    "        outputs_raw = pipe(prompts, max_new_tokens=300, do_sample=True)\n",
    "        outputs = [out[0]['generated_text'].split(base_prompt)[-1].strip() for out in outputs_raw]\n",
    "    \n",
    "    with open(dataset_file, 'a', encoding='utf-8') as f:\n",
    "        for text in outputs:\n",
    "            try:\n",
    "                if text.startswith('{') and text.endswith('}'):\n",
    "                    f.write(text.replace('\\n', ' ') + '\\n')\n",
    "                    generated_count += 1\n",
    "            except: continue\n",
    "    \n",
    "    print(f\"Batch: {current_batch}, Pace: {current_batch / (time.time()-t0):.2f} items/sec, Total: {generated_count}/{TARGET_COUNT}\")\n"
   ]
  },
  {
